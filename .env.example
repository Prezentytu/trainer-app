# Skopiuj do lokalnych sekretów (nie commituj .env).
# Nazwy zmiennych są JEDNE — rozdział dev/prod jest miejscem, nie prefiksem.
#   Lokalnie: ten plik / apps/web/.env.local → localhost.
#   Vercel: te same nazwy; checkbox Production vs Preview (nie twórz *_PROD).
#   Azure: te same nazwy App Settings na Web App `repmaxer-prod` (nie na trainer-app-api).
#   GitHub Actions: stare DEV_* zostają; prod = nowe PROD_* / *_PROD (patrz docs/deploy.md).
# Web (Vercel / apps/web):
NEXT_PUBLIC_API_URL=http://localhost:5210
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
# Tylko Vercel Production (nie Preview): https://repmaxer.pl/__clerk
# Lokal / Preview zostaw puste — Clerk Development nie obsługuje proxy.
NEXT_PUBLIC_CLERK_PROXY_URL=
NEXT_PUBLIC_VAPID_PUBLIC_KEY=

# API (Azure App Settings / apps/api):
# Database__Provider=Postgres
# Database__MigrateOnStartup=false
# ConnectionStrings__Default=Host=…;Database=…;Username=…;Password=…;SSL Mode=Require
# (pooled z -pooler w Azure; direct bez -pooler w GitHub secret do migracji CI)
ALLOWED_ORIGINS=http://localhost:3000
WEB_ORIGIN=http://localhost:3000
Clerk__Authority=
# Opcjonalnie — gdy ustawione, API waliduje aud JWT (Clerk JWT template):
Clerk__Audience=
Email__ResendApiKey=
Email__From=RepMaxer <onboarding@resend.dev>
Push__PublicKey=
Push__PrivateKey=
Push__Subject=mailto:support@example.com
Cron__Key=
Ai__OpenRouterApiKey=
